{% extends 'base.html.twig' %}

{% block title %}{% if app.current_route == 'app_date_index' %}Événements importants {%else  %} Tous les événements {% endif %}{% endblock %}

{% block page_content_class %}col-12{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css">
    <style>
        .events-table th,
        .events-table td {
            vertical-align: middle;
        }

        .events-table .event-description {
            max-width: 24rem;
            white-space: normal;
        }

        .events-table .event-actions {
            min-width: 12rem;
            white-space: nowrap;
        }

        .events-table .event-actions .btn {
            margin: 0.15rem;
        }

        .dataTables_wrapper {
            text-align: left;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <h1>📅 {% if app.current_route == 'app_date_index' %}Événements importants {% else %} Tous les événements {% endif %}</h1>
        {% if app.current_route == 'app_date_index' %}
            <a class="btn btn-secondary" href="{{ path('app_date_index_all') }}"> Voir Tous les événements </a>
        {% else %}
            <a class="btn btn-secondary" href="{{ path('app_date_index') }}"> Voir les Événements importants</a>
        {% endif %}
        {% if app.user %}
            <div class="text-center my-4">
                <a href="{{ path('app_date_new') }}" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Créer un nouvel événement
                </a>
            </div>
        {% endif %}

        {% if dates is not empty %}
            <div class="table-responsive">
                <table id="events-table" class="table table-striped table-hover events-table w-100">
                    <thead>
                    <tr>
                        <th>Événement</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Durée</th>
                        <th>Description</th>
                        <th>Couleur</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for date in dates %}
                        {% set duration = date.endDate.diff(date.startDate) %}
                        {% set duration_text %}
                            {% if duration.days > 0 %}{{ duration.days }} j {% endif %}
                            {% if duration.h > 0 %}{{ duration.h }} h {% endif %}
                            {% if duration.i > 0 %}{{ duration.i }} min{% endif %}
                        {% endset %}
                        <tr>
                            <td>
                                <a href="{{ path('app_date_show', {'id': date.id}) }}">{{ date.title }}</a>
                                {% if date.important %}<span title="Événement important">⭐</span>{% endif %}
                            </td>
                            <td data-order="{{ date.startDate.timestamp }}">{{ date.startDate|date('d/m/Y H:i') }}</td>
                            <td data-order="{{ date.endDate.timestamp }}">{{ date.endDate|date('d/m/Y H:i') }}</td>
                            <td data-order="{{ date.endDate.timestamp - date.startDate.timestamp }}">{{ duration_text|trim ?: '0 min' }}</td>
                            <td class="event-description" title="{{ date.description }}">
                                {{ date.description ? (date.description|length > 120 ? date.description|slice(0, 120) ~ '…' : date.description) : '—' }}
                            </td>
                            <td data-order="{{ date.color }}">
                                <span class="badge" data-color="#{{ date.color }}">#{{ date.color }}</span>
                            </td>
                            <td class="event-actions">
                                <a href="{{ path('app_date_show', {'id': date.id}) }}" class="btn btn-primary btn-sm" aria-label="Détails">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                                {% if app.user %}
                                    <a href="{{ path('app_date_edit', {'id': date.id}) }}" class="btn btn-warning btn-sm" aria-label="Modifier">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="card p-5 text-center">
                <div style="font-size: 4rem; margin-bottom: 1rem;">📭</div>
                <h3 style="color: var(--muted-text);">Aucun événement enregistré</h3>
                <p style="color: var(--muted-text); margin-top: 1rem;">Commencez par créer votre premier événement !</p>
            </div>
        {% endif %}

        {% if app.user and dates|length > 0 %}
            <div class="text-center mt-4">
                <a href="{{ path('app_date_new') }}" class="btn btn-success btn-lg">
                    <i class="bi bi-plus-circle"></i> Créer un nouvel événement
                </a>
            </div>
        {% endif %}
    </div>

    <script>
        const toRGB = (color) => {
            const { style } = new Option();
            style.backgroundColor = color;
            return style.backgroundColor;
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.badge').forEach(badge => {
                const color = badge.dataset.color;
                badge.style.backgroundColor = toRGB(color);

                // Ajuster la couleur du texte selon la luminosité du fond
                const rgb = toRGB(color).match(/\d+/g);
                if (rgb) {
                    const brightness = (parseInt(rgb[0]) * 299 + parseInt(rgb[1]) * 587 + parseInt(rgb[2]) * 114) / 1000;
                    badge.style.color = brightness > 128 ? '#1a1a2e' : '#ffffff';
                }
            });
        });
    </script>
{% endblock %}

{% block additionnal_javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            new DataTable('#events-table', {
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[1, 'asc']],
                scrollX: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.4/i18n/fr-FR.json'
                },
                columnDefs: [
                    {orderable: false, searchable: false, targets: 6}
                ]
            });
        });
    </script>
{% endblock %}
